",null,{"className":"absolute bottom-4 left-4 bg-black/80 backdrop-blur-md px-4 py-2 border border-white/10 text-xs font-mono text-white","children":"MADHURA HAWAL // FOUNDER & STRATEGIC DIRECTOR"}]]}],["$","div",null,{"className":"mb-24","children":[["$","h2",null,{"className":"font-display text-3xl sm:text-5xl uppercase tracking-tight text-white mb-8 border-b border-white/10 pb-4","children":"IT STARTED WITH HOSPITALITY"}],["$","div",null,{"className":"space-y-6 text-base sm:text-lg text-[#CCCCCC] font-sans leading-relaxed","children":["$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf"]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}]}],null,"$L15"]}],{},null,false]},null,false]},null,false],"$L16",false]],"m":"$undefined","G":["$17",[]],"s":false,"S":true}
